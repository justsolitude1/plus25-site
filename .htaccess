# Pages and unversioned scripts are checked with the server on every visit (a quick 304 when unchanged),
# so a visitor never keeps an old copy of the site. Pictures, models and fonts can be cached for a week.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css|json|xml|txt|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

# Our own error pages, with the right status codes
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # one address for the site: https, without www (the canonical links say the same)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://plus25dota.com%{REQUEST_URI} [R=301,L]
  # short addresses: /privacy serves privacy.html (links and the sitemap keep using the .html names)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([\w-]+)/?$ $1.html [L]
  # dev-only files, never served
  RewriteRule (^|/)(\.git|scripts|tools|supabase)(/|$) - [R=404,L]
  RewriteRule \.(zip|md|sql|mjs|py)$ - [R=404,L]
</IfModule>
